{
    "permission": {
        "*": "ask",
        "path": {
            "./*": "allow",
            "../*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "bash": {
            "*": "ask",
            "rm -rf *": "deny",
            "sudo *": "ask"
        },
        "external_directory": {
            "~/Projects/*": "ask",
            "~/.ssh/*": "deny",
            "/tmp/*": "allow",
            "~/Documents/sjb-brain/*": "allow",
            "*": "ask"
        }
    },
    "debugLog": false,
    "permissionReviewLog": true,
    "yoloMode": true
}
