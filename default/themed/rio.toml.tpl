[colors]
# Regular colors
background = '{{ background }}'
black = '{{ background }}'
blue = '{{ blue }}'
cyan = '{{ cyan }}'
foreground  = '{{ foreground }}'
green = '{{ green }}'
magenta = '{{ magenta }}'
red = '{{ red }}'
white = '{{ foreground }}'
yellow = '{{ yellow }}'

# Cursor
cursor = '{{ bright_foreground }}'
vi-cursor = '{{ accent }}'

# Navigation
# tabs and tabs-active set the inactive/active tab title colors.
# Tab island backgrounds are derived from the window background color.
tabs = '{{ muted }}'
tabs-active = '{{ selection }}'
split = '{{ muted }}'
split-active = '{{ selection }}'

# Search
search-match-background = '{{ light_background }}'
search-match-foreground = '{{ dark_foreground }}'
search-focused-match-background = '{{ lighter_background }}'
search-focused-match-foreground = '{{ dark_foreground }}'

# Selection
selection-foreground = '{{ selection_foreground }}'
selection-background = '{{ selection_background }}'

# Dim colors
dim-black = '{{ background }}'
dim-blue = '{{ blue }}'
dim-cyan = '{{ cyan }}'
dim-foreground = '{{ foreground }}'
dim-green = '{{ green }}'
dim-magenta = '{{ magenta }}'
dim-red = '{{ red }}'
dim-white = '{{ foreground }}'
dim-yellow = '{{ yellow }}'

# Light colors
light-black = '{{ lighter_background }}'
light-blue = '{{ bright_blue }}'
light-cyan = '{{ bridht_cyan }}'
light-foreground = '{{ bright_foreground }}'
light-green = '{{ bright_green }}'
light-magenta = '{{ bright_magenta }}'
light-red = '{{ bright_red}}'
light-white = '{{ bright_foreground }}'
light-yellow = '{{ bright_yellow }}'
