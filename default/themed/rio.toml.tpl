[colors]
# Regular colors
background = '{{ background }}'
black = '{{ color0 }}'
blue = '{{ color4 }}'
cyan = '{{ color6 }}'
foreground  = '{{ foreground }}'
green = '{{ color2 }}'
magenta = '{{ color5 }}'
red = '{{ color1 }}'
white = '{{ color15 }}'
yellow = '{{ color11 }}'

# Cursor
cursor = '{{ cursor }}'
vi-cursor = '{{ accent }}'

# Navigation
# tabs and tabs-active set the inactive/active tab title colors.
# Tab island backgrounds are derived from the window background color.
tabs = '{{ color8 }}'
tabs-active = '{{ color15 }}'
split = '{{ color8 }}'
split-active = '{{ color15 }}'

# Search
search-match-background = '{{ color12 }}'
search-match-foreground = '{{ color15 }}'
search-focused-match-background = '{{ color3 }}'
search-focused-match-foreground = '{{ color15 }}'

# Selection
selection-foreground = '{{ selection_foreground }}'
selection-background = '{{ selection_background }}'

# Dim colors
dim-black = '{{ color0 }}'
dim-blue = '{{ color4 }}'
dim-cyan = '{{ color6 }}'
dim-foreground = '{{ foreground }}'
dim-green = '{{ color2 }}'
dim-magenta = '{{ color5 }}'
dim-red = '{{ color1 }}'
dim-white = '{{ color15 }}'
dim-yellow = '{{ color11 }}'

# Light colors
light-black = '{{ color8 }}'
light-blue = '{{ color12 }}'
light-cyan = '{{ color14 }}'
light-foreground = '{{ foreground }}'
light-green = '{{ color10 }}'
light-magenta = '{{ color13 }}'
light-red = '{{ color9 }}'
light-white = '{{ color15 }}'
light-yellow = '{{ color11 }}'
